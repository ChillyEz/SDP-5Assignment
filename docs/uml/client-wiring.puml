@startuml client-wiring
!include style.puml
title Strategy Calculator\n<size:14>Client construction · package calculator</size>
top to bottom direction
skinparam minClassWidth 210

class Main <<Client>> {
    {static} + main(args: String[]): void
}

together {
    class Calculator
    class AddStrategy
    class SubtractStrategy
    class MultiplyStrategy
    class DivisionStrategy
    class PowerStrategy
}

hide Calculator members
hide AddStrategy members
hide SubtractStrategy members
hide MultiplyStrategy members
hide DivisionStrategy members
hide PowerStrategy members

Main .down.> Calculator
Main .down.> AddStrategy
Main .down.> SubtractStrategy
Main .down.> MultiplyStrategy
Main .down.> DivisionStrategy
Main .down.> PowerStrategy

Calculator -[hidden]right-> AddStrategy
AddStrategy -[hidden]right-> SubtractStrategy
SubtractStrategy -[hidden]right-> MultiplyStrategy
MultiplyStrategy -[hidden]right-> DivisionStrategy
DivisionStrategy -[hidden]right-> PowerStrategy

legend bottom
  Every dashed arrow is a creation dependency: Main constructs the target with new.
  Main passes the initial strategy to Calculator and replaces it through setStrategy.
  This view separates client wiring from interface realization to avoid crossed links.
endlegend
@enduml
